{
  "name": "@zcatalyst/connections",
  "version": "0.0.1",
  "main": "./dist-cjs/index.js",
  "module": "./dist-es/index.js",
  "types": "./dist-types/index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catalystbyzoho/zcatalyst-sdk-js.git",
    "directory": "packages/connections"
  },
  "scripts": {
    "build": "pnpm clean && concurrently 'pnpm:build:cjs' 'pnpm:build:es' 'pnpm:build:types && pnpm build:types:downlevel'",
    "build:cjs": "pnpm tsc -p tsconfig.cjs.json",
    "build:es": "pnpm tsc -p tsconfig.es.json && node ../../scripts/fix-esm-json-imports.js dist-es",
    "build:types": "pnpm tsc -p tsconfig.types.json",
    "docs": "pnpm run typedoc",
    "build:types:downlevel": "rimraf dist-types/ts3.4 && downlevel-dts dist-types dist-types/ts3.4",
    "clean": "rimraf ./dist-* && rimraf *.tsbuildinfo || exit 0",
    "typedoc": "npx typedoc",
    "test": "jest --config ./jest.config.js",
    "lint": "eslint -c ../../eslint.config.mjs \"src/**/*.ts\"",
    "format": "prettier  --ignore-path ../.prettierignore --write \"{src, test}/*.ts\""
  },
  "dependencies": {
    "@zcatalyst/transport": "workspace:^",
    "@zcatalyst/utils": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist-*/**"
  ],
  "keywords": [
    "connections",
    "zcatalyst",
    "catalyst"
  ]
}
